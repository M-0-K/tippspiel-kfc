# Kopieren nach .env und ALLE Passwörter ändern (.env wird nicht eingecheckt)
# Starke Passwörter erzeugen:  openssl rand -base64 18

# Logins der Webseite
ADMIN_PASSWORD=changeme
BARKEEPER_PASSWORD=changeme

# Datenbank
DB_USER=webserver
DB_PASSWORD=changeme
MYSQL_ROOT_PASSWORD=changeme

# Öffentliche Adresse (Footer, QR-Code)
PUBLIC_URL=https://kulow-fighters.win
CURRENT_KAMPFNACHT=1

# Cloudflare-Tunnel (Zero Trust → Networks → Tunnels → Token)
CF_TUNNEL_TOKEN=

# VS Code im Browser (nur compose.server.yml)
CODE_SERVER_PASSWORD=changeme
# Linux-Benutzer, dem die Projektdateien gehören (Ausgabe von: id -u / id -g)
PUID=1000
PGID=1000
# optional: öffentliche Adresse von phpMyAdmin, z.B. https://pma.kulow-fighters.win
PMA_URL=
